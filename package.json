{
    "name": "budgetcheck",
    "version": "1.0.28",
    "private": true,
    "scripts": {
        "db:naming-check": "bash scripts/check-db-naming.sh",
        "lint": "node scripts/check-frontend.js",
        "test": "node scripts/check-frontend.js && npm run l10n:check",
        "l10n": "node scripts/build-l10n-js.js",
        "l10n:variants": "php scripts/sync-l10n-variants.php && php scripts/regenerate-l10n-js.php",
        "l10n:check": "php scripts/check-l10n-parity.php && php scripts/check-l10n-placeholders.php && php scripts/sync-l10n-variants.php --check"
    }
}
